FROM debian:%%DEBIAN_IMAGE%%

ARG DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.source="https://github.com/zhurkin/gost-container"
LABEL org.opencontainers.image.title="gost-container"
LABEL org.opencontainers.image.description="Minimal container image for GOST v3"
LABEL org.opencontainers.image.licenses="MIT"
LABEL io.github.zhurkin.gost.version="%%GOST_VERSION%%"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 gost && \
    useradd \
        --uid 10001 \
        --gid 10001 \
        --home-dir /var/lib/gost \
        --shell /usr/sbin/nologin \
        --no-create-home \
        gost && \
    install -d -o gost -g gost -m 0750 /var/lib/gost && \
    install -d -o root -g gost -m 0750 /etc/gost

COPY --from=fetch --chown=root:root /out/gost /usr/local/bin/gost

RUN chmod 0755 /usr/local/bin/gost && \
    /usr/local/bin/gost -V

ENV HOME=/var/lib/gost

USER gost:gost

ENTRYPOINT ["/usr/local/bin/gost"]
