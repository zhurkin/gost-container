FROM debian:%%DEBIAN_IMAGE%% AS fetch

ARG DEBIAN_FRONTEND=noninteractive

ARG GOST_VERSION="%%GOST_VERSION%%"
ARG GOST_OS="%%GOST_OS%%"
ARG GOST_ARCH="%%GOST_ARCH%%"
ARG GOST_SHA256="%%GOST_SHA256%%"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl && \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    archive="gost_${GOST_VERSION}_${GOST_OS}_${GOST_ARCH}.tar.gz"; \
    url="https://github.com/go-gost/gost/releases/download/v${GOST_VERSION}/${archive}"; \
    \
    echo "Downloading ${url}"; \
    curl \
        --fail \
        --location \
        --retry 3 \
        --retry-all-errors \
        --output "/tmp/${archive}" \
        "${url}"; \
    \
    echo "${GOST_SHA256}  /tmp/${archive}" | sha256sum -c -; \
    \
    mkdir -p /tmp/gost-extract /out; \
    tar -xzf "/tmp/${archive}" -C /tmp/gost-extract; \
    \
    gost_bin="$(find /tmp/gost-extract -type f -name gost -print -quit)"; \
    test -n "${gost_bin}"; \
    \
    install -m 0755 "${gost_bin}" /out/gost; \
    \
    /out/gost -V


FROM debian:%%DEBIAN_IMAGE%%

ARG DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.source="https://github.com/zhurkin/gost-container"
LABEL org.opencontainers.image.title="gost-container"
LABEL org.opencontainers.image.description="Minimal container image for GOST v3"
LABEL org.opencontainers.image.licenses="MIT"

LABEL io.github.zhurkin.gost.version="%%GOST_VERSION%%"
LABEL io.github.zhurkin.gost.os="%%GOST_OS%%"
LABEL io.github.zhurkin.gost.arch="%%GOST_ARCH%%"
LABEL io.github.zhurkin.debian.image="%%DEBIAN_IMAGE%%"
LABEL io.github.zhurkin.debian.suite="%%DEBIAN_SUITE%%"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        passwd && \
    rm -rf /var/lib/apt/lists/*

# Dedicated unprivileged service account.
#
# Fixed UID/GID makes bind mounts and orchestrated deployments predictable.
RUN groupadd \
        --gid 10001 \
        gost && \
    useradd \
        --uid 10001 \
        --gid 10001 \
        --home-dir /var/lib/gost \
        --shell /usr/sbin/nologin \
        --no-create-home \
        --comment "GOST service user" \
        gost

# Runtime directories:
#
# /etc/gost
#   Configuration owned by root and readable by the GOST service user.
#
# /var/lib/gost
#   Writable home/state directory for GOST.
RUN install -d \
        -o root \
        -g gost \
        -m 0750 \
        /etc/gost && \
    install -d \
        -o gost \
        -g gost \
        -m 0750 \
        /var/lib/gost

COPY --from=fetch --chown=root:root /out/gost /usr/local/bin/gost

RUN chmod 0755 /usr/local/bin/gost && \
    /usr/local/bin/gost -V

ENV HOME=/var/lib/gost

WORKDIR /var/lib/gost

USER 10001:10001

STOPSIGNAL SIGTERM

ENTRYPOINT ["/usr/local/bin/gost"]
